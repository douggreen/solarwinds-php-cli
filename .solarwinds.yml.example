# SolarWinds PHP CLI Configuration Example
# Copy this file to ~/.solarwinds.yml and customize

# Required: SolarWinds API credentials
token: "your-api-token-here"
api_base_url: "https://api.na-01.cloud.solarwinds.com"

# Optional: Behavior settings
debug: false
progress: true
validate: false

# Optional: API retention limit (varies by license)
# Standard plans typically retain 14 days, enterprise plans may offer 30+ days
# This prevents futile API queries for data beyond retention window
api_retention_days: 14

# Optional: Global CMS type for all sites
# Valid values: drupal, wordpress, other, unknown (default)
# Can be overridden per-site in site configuration
cms: drupal

# Optional: Database configuration
database:
  path: ~/.solarwinds/logs.db        # Default SQLite database location

# Optional: Site definitions for multi-site filtering
# Note: Sites are keyed by hostname, not a list
sites:
  example.com:
    name: main
    label: Main Site
    cms: drupal                       # Optional: Override global CMS setting for this site
  blog.example.com:
    name: blog
    label: Company Blog
    cms: wordpress                    # Different CMS for this site
  app.example.com:
    name: app
    label: Web Application

# Optional: Custom command aliases
# Note: These examples demonstrate proper option syntax
aliases:
  errors: 'search "error" --cols=status --time=1h'
  quickbot: bot --time=1h --cols=ua
  5xx: status --filter-status-code=5 --time=1d --cols=host,path
  404s: status --filter-status-code=404 --time=1d --cols=host,path

# Optional: IP blocking configuration
blocking:
  # IPs/ranges that should NEVER be blocked (allowlist)
  allowlist:
    - "10.0.0.0/8"          # Internal network example
    - "192.168.1.0/24"      # Another internal range
    - "203.0.113.50"        # Specific trusted IP

  # Additional trusted bot user-agents (beyond defaults)
  # Default list includes: Googlebot, bingbot, Slackbot, facebookexternalhit, etc.
  trusted_bots:
    - "MyCustomBot"
    - "PartnerCrawler"

  # Blocking decision thresholds (optional - these are the defaults)
  # These are timeframe-relative thresholds that automatically scale based on scan window
  thresholds:
    # Scaled thresholds (auto-adjust for timeframe)
    min_requests_per_hour: 10         # 10 req/hr minimum for short scans
    min_requests_per_day: 70          # ~1000 over 2 weeks minimum
    urgent_requests_per_hour: 5000    # Immediate alert threshold

    # Duration as % of scan window
    min_duration_ratio: 0.1           # Must span 10% of window (1.5min for 15min scan)

    # Behavior thresholds
    high_confidence_40x_ratio: 0.8    # 80% failure rate = scanning
    exploit_ratio_threshold: 0.7      # 70% exploit patterns = attack

    # Single-event filtering
    single_event_threshold_hours: 1   # Bursts <1hr = single event
    single_event_critical_volume: 10000  # Unless >10k reqs + critical

# Optional: Risk scoring configuration for exploit detection
risk_scoring:
  # Factor weights (total should = 1.0)
  weights:
    origin_impact: 0.30      # Bypassed CDN, hit origin
    volume_rate: 0.25        # Requests per hour
    attack_severity: 0.20    # Scan types + severity
    historical: 0.15         # Known bad actor?
    server_impact: 0.10      # Errors, load

  # Origin impact scoring (0-100)
  origin_impact:
    edge_blocked_100: 0      # All blocked at edge = no risk
    edge_blocked_high: 20    # >80% blocked at edge
    origin_50_percent: 60    # Half getting through
    origin_high: 100         # Most hitting origin

  # Volume rate scoring (requests/hour → 0-100)
  volume_rate:
    thresholds:
      - { rate: 10, score: 10 }      # Background noise
      - { rate: 50, score: 30 }      # Low volume
      - { rate: 100, score: 50 }     # Moderate
      - { rate: 500, score: 70 }     # High
      - { rate: 1000, score: 85 }    # Very high
      - { rate: 5000, score: 100 }   # Extreme

  # Attack severity scoring (0-100)
  attack_severity:
    # Pattern severity classifications
    critical_patterns:
      - sqli
      - cmdi
      - rce
      - pma
    high_patterns:
      - xss
      - lfi
      - xxe
      - ssrf
      - ssti
    medium_patterns:
      - file
      - boot
      - dbg
      - api
    low_patterns:
      - scan
      - info

    # Base scores for single pattern types
    single_low: 10
    single_medium: 20
    single_high: 40
    single_critical: 60

    # Bonuses for multiple pattern types
    multiple_types_bonus: 20         # Add for 2+ patterns
    three_plus_types_bonus: 30       # Add for 3+ patterns

  # Historical scoring (0-100)
  historical:
    no_history: 0
    seen_before_low: 20         # Appeared in --1w/--1m scan
    seen_before_medium: 50      # Previous BLOCK MAYBE
    known_bad_actor: 100        # Previous BLOCK NOW

  # Server impact scoring (0-100)
  server_impact:
    no_php_execution: 0         # All 404s
    php_execution_404: 30       # Hit PHP but 404
    php_execution_40x: 50       # Hit PHP, other 40x
    php_errors_5xx: 80          # Generated errors
    php_success_200: 100        # Successful exploitation?

  # Final risk classification (based on weighted score 0-100)
  risk_levels:
    critical: 80      # >= 80 = BLOCK NOW + ALERT
    high: 60          # >= 60 = BLOCK NOW
    medium: 40        # >= 40 = BLOCK MAYBE
    low: 20           # >= 20 = MONITOR
    noise: 0          # < 20 = IGNORE
