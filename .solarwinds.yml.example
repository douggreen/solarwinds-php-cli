# SolarWinds PHP CLI Configuration Example
# Copy this file to ~/.solarwinds.yml and customize

# Required: SolarWinds API credentials
token: "your-api-token-here"
base_url: "https://api.na-01.cloud.solarwinds.com"

# Optional: Behavior settings
debug: false
progress: true
validate: false

# Optional: API retention limit (varies by license)
# Standard plans typically retain 14 days, enterprise plans may offer 30+ days
# This prevents futile API queries for data beyond retention window
api_retention_days: 14

# Optional: Global CMS type for all sites
# Valid values: drupal, wordpress, other, unknown (default)
# Can be overridden per-site in site configuration
cms: drupal

# Optional: Database configuration
database:
  path: ~/.solarwinds/logs.db        # Default SQLite database location

# Optional: Site definitions for multi-site filtering
# Note: Sites are keyed by hostname, not a list
sites:
  example.com:
    name: main
    label: Main Site
    cms: drupal                       # Optional: Override global CMS setting for this site
  blog.example.com:
    name: blog
    label: Company Blog
    cms: wordpress                    # Different CMS for this site
  app.example.com:
    name: app
    label: Web Application

# Optional: Custom command aliases
aliases:
  errors: 'search "error" --status --1h'
  quickbot: 'bot --1h --ua'

# Optional: IP blocking configuration
blocking:
  # IPs/ranges that should NEVER be blocked (allowlist)
  allowlist:
    - "10.0.0.0/8"          # Internal network example
    - "192.168.1.0/24"      # Another internal range
    - "203.0.113.50"        # Specific trusted IP

  # Additional trusted bot user-agents (beyond defaults)
  # Default list includes: Googlebot, bingbot, Slackbot, facebookexternalhit, etc.
  trusted_bots:
    - "MyCustomBot"
    - "PartnerCrawler"

  # Blocking decision thresholds (optional - these are the defaults)
  # These are absolute thresholds - adjust based on your traffic volume and risk tolerance
  # They are NOT timeframe-relative (use --min-requests command option for rate-based filtering)
  thresholds:
    min_requests: 100                 # Minimum exploit attempts (absolute count, not per-timeframe)
    min_duration_hours: 2             # Attack must span at least this duration
    high_confidence_40x_ratio: 0.8    # 80%+ failed requests = high confidence (0.0-1.0)
